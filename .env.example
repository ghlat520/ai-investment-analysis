# ===================================
# AI投研助手系统 - 环境变量配置
# ===================================
# 复制本文件为 .env 并填写实际值

# === 数据库 ===
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_investment
DATABASE_URL_SYNC=postgresql+psycopg2://user:password@localhost:5432/ai_investment

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === LLM API Keys ===
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=sk-ant-xxx

# === Ollama 本地模型 ===
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_DEFAULT_MODEL=qwen2.5:14b
OLLAMA_MAX_CONCURRENT=1
OLLAMA_REQUEST_TIMEOUT=300

# === 数据源 API Keys ===
TUSHARE_TOKEN=

# === 搜索引擎 API Keys（逗号分隔支持多Key轮换）===
BOCHA_API_KEYS=
TAVILY_API_KEYS=
BRAVE_API_KEYS=
SERPAPI_KEYS=

# === 通知配置（可同时配置多个）===

# 企业微信 Webhook
WECHAT_WEBHOOK_URL=

# 飞书 Webhook
FEISHU_WEBHOOK_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 邮件
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVERS=

# === 调度配置 ===
# 分析触发时间（24h格式）
ANALYSIS_TRIGGER_TIME=17:00
# 时区
TIMEZONE=Asia/Shanghai

# === 日志 ===
LOG_LEVEL=INFO
